# Copy to .env (never commit .env). Every variable is optional for starting the server;
# the AI features (prescription reading, pack scanning, voice calls) need OPENAI_API_KEY.
OPENAI_API_KEY=
PORT=8091
# Optional: Web Push call alerts (generate a P-256 VAPID key pair, base64url)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional model overrides (defaults in lib/openai.mjs)
# REALTIME_MODEL=gpt-realtime-2.1
# TRANSCRIBE_MODEL=gpt-transcribe
# VISION_MODEL=gpt-5.6-sol
# QUICK_MODEL=gpt-5.2
# PACK_MODEL=gpt-5.2
# REALTIME_VOICE=marin
